APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
ALLOW_PRIVATE_NETWORKS=false
MAX_PAGE_BYTES=2000000
NAVIGATION_TIMEOUT_MS=20000

# Durable task records and resumable checkpoints; defaults to EVIDENCE_DIR/tasks.
TASK_STATE_DIR=

# Remote Ollama server defaults. Use HTTPS and a server-side token in production.
OLLAMA_BASE_URL=https://ollama.example.com
# Optional per-role endpoints; each falls back to OLLAMA_BASE_URL when blank.
OLLAMA_BASE_URL_DEFAULT=
OLLAMA_BASE_URL_DECIDER=
OLLAMA_BASE_URL_GOAL_STATE=
OLLAMA_BASE_URL_SYNTHESIS=
OLLAMA_BASE_URL_NAVIGATE=
OLLAMA_BASE_URL_INTERACT=
OLLAMA_BASE_URL_EXTRACT=
OLLAMA_BASE_URL_RECOVER=
OLLAMA_API_KEY=
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_MAX_TOKENS=1200

# Model names must already be pulled on the remote Ollama server.
OLLAMA_MODEL_DEFAULT=qwen2.5:7b
OLLAMA_MODEL_DECIDER=
OLLAMA_MODEL_GOAL_STATE=qwen3.5:0.8b
OLLAMA_MODEL_SYNTHESIS=

# Optional Strands Decider endpoint for choosing among browser-discovered research sources.
# Leave empty to use the Ollama research planner.
STRANDS_DECIDER_URL=
STRANDS_DECIDER_PATH=/v1/systemone
STRANDS_DECIDER_API_KEY=
OLLAMA_MODEL_NAVIGATE=
OLLAMA_MODEL_INTERACT=
OLLAMA_MODEL_EXTRACT=
OLLAMA_MODEL_RECOVER=

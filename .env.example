APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
ALLOW_PRIVATE_NETWORKS=false
MAX_PAGE_BYTES=2000000
NAVIGATION_TIMEOUT_MS=20000
# SEO/QA crawl page budget (1-1,000; default 200).
AUDIT_MAX_PAGES=200
# Set true to suppress all remediation/recommendation output; validation still runs.
AUDIT_SKIP_RECOMMENDATIONS=false

# Browser backend: self-hosted Steel in Compose, or local Playwright when explicitly selected.
BROWSER_BACKEND=steel
# One primary research tab plus up to two useful secondary tabs.
BROWSER_MAX_TABS=3
STEEL_API_KEY=
STEEL_API_BASE_URL=http://steel-browser:3000/v1
# Resolve the Docker service hostname to its container IP for Steel's CDP Host check.
STEEL_CDP_HOST=auto
# Hostname used by your local browser to open Steel's debug viewer.
STEEL_VIEWER_HOST=localhost
STEEL_SESSION_TIMEOUT_MS=300000
# Extra preview retention is added to STEEL_SESSION_TIMEOUT_MS for the session's total TTL.
STEEL_SESSION_RETENTION_MS=600000

# Optional official Steel MCP adapter. Keep disabled until the MCP connection is verified.
STEEL_MCP_ENABLED=false
STEEL_MCP_PROFILE=browse
STEEL_MCP_BASE_URL=http://steel-browser:3000/v1

# Durable task records and resumable checkpoints; defaults to EVIDENCE_DIR/tasks.
TASK_STATE_DIR=

# Remote Ollama server defaults. Use HTTPS and a server-side token in production.
OLLAMA_BASE_URL=https://ollama.example.com
# Optional per-role endpoints; each falls back to OLLAMA_BASE_URL when blank.
OLLAMA_BASE_URL_DEFAULT=
OLLAMA_BASE_URL_DECIDER=
OLLAMA_BASE_URL_GOAL_STATE=
OLLAMA_BASE_URL_SYNTHESIS=
OLLAMA_BASE_URL_NAVIGATE=
OLLAMA_BASE_URL_INTERACT=
OLLAMA_BASE_URL_EXTRACT=
OLLAMA_BASE_URL_BROWSER_CLEANUP=
OLLAMA_BASE_URL_RECOVER=
OLLAMA_API_KEY=
OLLAMA_TIMEOUT_SECONDS=90
# Per-tier Ollama model retention after the last request. Use 0 to unload immediately.
# Tune independently for the available RAM/VRAM on the Ollama host.
OLLAMA_KEEP_ALIVE_DEFAULT=5m
OLLAMA_KEEP_ALIVE_LIGHT=2m
# Legacy fallback for any model not matching either configured tier.
# OLLAMA_KEEP_ALIVE=0
# Bound prompt + generation context to reduce KV-cache memory use.
OLLAMA_NUM_CTX=8192
OLLAMA_MAX_TOKENS=1200
OLLAMA_PLAN_MAX_TOKENS=1800
OLLAMA_SYNTHESIS_MAX_TOKENS=2400

# Exactly two model names: main handles planning/navigation/synthesis; light handles extraction/recovery/goal checks.
# Pull both on the remote Ollama server. Role-specific model overrides are intentionally not used.
OLLAMA_MODEL_DEFAULT=qwen3.5:9b
OLLAMA_MODEL_LIGHT=qwen3.5:4b

# Optional Strands Decider endpoint for choosing among browser-discovered research sources.
# Leave empty to use the Ollama research planner.
STRANDS_DECIDER_URL=
STRANDS_DECIDER_PATH=/v1/systemone
STRANDS_DECIDER_API_KEY=
